<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Course Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <img src="/images/logo.png" alt="University Logo" width="100">
    <h1>Course Management</h1>
  </header>
  <main>
    <section>
      <h2>Add New Course</h2>
      <form action="/admin/courses/add" method="POST">
        <label for="courseCode">Course Code:</label>
        <input type="text" id="courseCode" name="courseCode" required>
        <label for="courseName">Course Name:</label>
        <input type="text" id="courseName" name="courseName" required>
        <label for="department">Department:</label>
        <input type="text" id="department" name="department" required>
        <label for="level">Level:</label>
        <input type="number" id="level" name="level" required>
        <label for="seatsTotal">Total Seats:</label>
        <input type="number" id="seatsTotal" name="seatsTotal" required>
        <label for="prerequisites">Prerequisites (comma-separated):</label>
        <input type="text" id="prerequisites" name="prerequisites">
        <h3>Schedule</h3>
        <div id="schedule-container" class="schedule-form">
          <div>
            <label>Day:</label>
            <select name="days">
              <option value="M">Monday</option>
              <option value="T">Tuesday</option>
              <option value="W">Wednesday</option>
              <option value="Th">Thursday</option>
              <option value="F">Friday</option>
            </select>
            <label>Start Time:</label>
            <input type="time" name="startTimes" required>
            <label>End Time:</label>
            <input type="time" name="endTimes" required>
          </div>
        </div>
        <button type="button" onclick="addScheduleSlot()">Add Another Slot</button>
        <button type="submit">Add Course</button>
      </form>
      <h2>Existing Courses</h2>
      <div class="course-container">
        <% courses.forEach(course => { %>
          <div class="course">
            <h3><%= course.courseCode %>: <%= course.courseName %></h3>
            <form action="/admin/courses/update/<%= course.courseCode %>" method="POST">
              <input type="text" name="courseName" value="<%= course.courseName %>">
              <input type="text" name="department" value="<%= course.department %>">
              <input type="number" name="level" value="<%= course.level %>">
              <input type="number" name="seatsTotal" value="<%= course.seatsTotal %>">
              <input type="text" name="prerequisites" value="<%= course.prerequisites.join(',') %>">
              <div class="schedule-form">
                <% course.schedule.forEach((slot, index) => { %>
                  <div>
                    <label>Day:</label>
                    <select name="days">
                      <option value="M" <%= slot.day === 'M' ? 'selected' : '' %>>Monday</option>
                      <option value="T" <%= slot.day === 'T' ? 'selected' : '' %>>Tuesday</option>
                      <option value="W" <%= slot.day === 'W' ? 'selected' : '' %>>Wednesday</option>
                      <option value="Th" <%= slot.day === 'Th' ? 'selected' : '' %>>Thursday</option>
                      <option value="F" <%= slot.day === 'F' ? 'selected' : '' %>>Friday</option>
                    </select>
                    <label>Start Time:</label>
                    <input type="time" name="startTimes" value="<%= slot.startTime %>" required>
                    <label>End Time:</label>
                    <input type="time" name="endTimes" value="<%= slot.endTime %>" required>
                  </div>
                <% }) %>
              </div>
              <button type="submit">Update</button>
            </form>
            <form action="/admin/courses/delete/<%= course.courseCode %>" method="POST">
              <button type="submit">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
      <a href="/admin/dashboard">Back to Dashboard</a>
    </section>
  </main>
  <script>
    function addScheduleSlot() {
      const container = document.getElementById('schedule-container');
      const slot = document.createElement('div');
      slot.innerHTML = `
        <label>Day:</label>
        <select name="days">
          <option value="M">Monday</option>
          <option value="T">Tuesday</option>
          <option value="W">Wednesday</option>
          <option value="Th">Thursday</option>
          <option value="F">Friday</option>
        </select>
        <label>Start Time:</label>
        <input type="time" name="startTimes" required>
        <label>End Time:</label>
        <input type="time" name="endTimes" required>
      `;
      container.appendChild(slot);
    }
  </script>
</body>
</html>