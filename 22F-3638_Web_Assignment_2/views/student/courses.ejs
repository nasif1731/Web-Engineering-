<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Course Search</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <img src="/images/logo.png" alt="University Logo" width="100">
    <h1>Course Search</h1>
  </header>
  <section>
    <form>
      <label for="department">Department:</label>
      <input type="text" id="department" name="department" placeholder="e.g., CS">
      <label for="level">Level:</label>
      <input type="number" id="level" name="level" placeholder="e.g., 300">
      <label for="time">Time (e.g., 09:00-17:00):</label>
      <input type="text" id="time" name="time" placeholder="HH:MM-HH:MM">
      <label for="days">Days (M,T,W,Th,F):</label>
      <input type="text" id="days" name="days" placeholder="e.g., M,W">
      <label for="openSeats">Open Seats Only:</label>
      <input type="checkbox" id="openSeats" name="openSeats">
    </form>
    <div id="course-list"></div>
    <a href="/student/dashboard">Back to Dashboard</a>
  </section>
  <script src="/js/student/courses.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</body>
</html>